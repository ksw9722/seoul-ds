# Seoul DS Android-only build adaptation. The pinned upstream checkout stays unchanged.
# The Android implementation uses Net_Slirp, not the optional desktop PCAP backend.
# Legacy bundled PCAP headers retain advertising-clause notices; do not compile them
# into this separately distributed APK. Original source and notices remain available.

get_target_property(_net_sources net-utils SOURCES)
set(_net_without_pcap)
set(_removed_pcap 0)
foreach(_source IN LISTS _net_sources)
    if(_source MATCHES "(^|/)Net_PCap\\.cpp$")
        math(EXPR _removed_pcap "${_removed_pcap} + 1")
    else()
        list(APPEND _net_without_pcap "${_source}")
    endif()
endforeach()
if(NOT _removed_pcap EQUAL 1)
    message(FATAL_ERROR "Pinned Android PCAP source shape changed; review dependencies before building")
endif()
set_property(TARGET net-utils PROPERTY SOURCES "${_net_without_pcap}")

get_target_property(_android_source_dir melonDS-lib SOURCE_DIR)
set(_platform_original "${_android_source_dir}/PlatformAndroid.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_platform_original}")
file(READ "${_platform_original}" _platform_text)
string(REGEX MATCHALL "#include \"pcap/pcap.h\"" _pcap_includes "${_platform_text}")
list(LENGTH _pcap_includes _pcap_include_count)
if(NOT _pcap_include_count EQUAL 1)
    message(FATAL_ERROR "Pinned PlatformAndroid PCAP include changed; manual review required")
endif()
string(REPLACE "#include \"pcap/pcap.h\""
    "// Seoul DS: unused desktop PCAP header omitted from Android build."
    _platform_text "${_platform_text}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/seoul-generated")
set(_platform_generated "${CMAKE_CURRENT_BINARY_DIR}/seoul-generated/PlatformAndroid.cpp")
file(WRITE "${_platform_generated}.in" "${_platform_text}")
configure_file("${_platform_generated}.in" "${_platform_generated}" COPYONLY)
get_target_property(_android_sources melonDS-lib SOURCES)
set(_android_adapted)
set(_replaced_platform 0)
foreach(_source IN LISTS _android_sources)
    if(_source MATCHES "(^|/)PlatformAndroid\\.cpp$")
        list(APPEND _android_adapted "${_platform_generated}")
        math(EXPR _replaced_platform "${_replaced_platform} + 1")
    else()
        list(APPEND _android_adapted "${_source}")
    endif()
endforeach()
if(NOT _replaced_platform EQUAL 1)
    message(FATAL_ERROR "Pinned Android platform source shape changed; manual review required")
endif()
set_property(TARGET melonDS-lib PROPERTY SOURCES "${_android_adapted}")
target_include_directories(melonDS-lib PRIVATE "${_android_source_dir}")
message(STATUS "Seoul DS: optional PCAP backend and unused PCAP header excluded")
